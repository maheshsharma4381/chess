# Server (apps/server). Keys are matched case-insensitively (database_url works too).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# App tables live in their own schema, never Supabase's PostgREST-exposed "public".
DB_SCHEMA=chess
REDIS_URL=redis://127.0.0.1:6379
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional: Google sign-in (both required to enable it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: a native Stockfish binary for the review worker (default: the bundled WASM build).
STOCKFISH_PATH=

# Web (apps/web): where the Next server forwards /api/v1/* (unset = no accounts, local-only).
SERVER_URL=http://localhost:4000

# Lichess explorer (personal API token; the explorer rejects anonymous requests)
LICHESS_API_TOKEN=
